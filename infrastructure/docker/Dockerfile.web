# Build context must be the repo root (pnpm workspace), e.g.:
#   docker build -f infrastructure/docker/Dockerfile.web .
FROM node:22-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @nltech/web build

FROM nginx:1.27-alpine AS runtime
COPY infrastructure/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/Frontend/Web/dist /usr/share/nginx/html
EXPOSE 80
