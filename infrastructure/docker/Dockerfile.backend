# Shared multi-stage Dockerfile for Auth, Catalog and Gateway.
# Build context must be the repo root (pnpm workspace), e.g.:
#   docker build -f infrastructure/docker/Dockerfile.backend --build-arg SERVICE_DIR=Backend/Auth .
ARG NODE_VERSION=22-bookworm-slim

FROM node:${NODE_VERSION} AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r build

FROM node:${NODE_VERSION} AS runtime
ARG SERVICE_DIR
ENV SERVICE_DIR=${SERVICE_DIR}
ENV NODE_ENV=production
ENV CI=true
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
COPY --from=build /repo /repo
RUN pnpm install --prod --frozen-lockfile
CMD ["sh", "-c", "node $SERVICE_DIR/build/app.js"]
